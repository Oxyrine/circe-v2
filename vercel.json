{
  "version": 2,
  "builds": [
    {
      "src": "api/*.py",
      "use": "@vercel/python"
    },
    {
      "src": "demo/**",
      "use": "@vercel/static"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "no-referrer",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "Cross-Origin-Opener-Policy": "same-origin",
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains",
        "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
      },
      "continue": true
    },
    {
      "src": "/api/health",
      "dest": "/api/health.py"
    },
    {
      "src": "/api/rescore",
      "dest": "/api/rescore.py"
    },
    {
      "src": "/api/prioritise",
      "dest": "/api/prioritise.py"
    },
    {
      "src": "/api/assistant",
      "dest": "/api/assistant.py"
    },
    {
      "src": "/api/(ai/)?narrative",
      "dest": "/api/narrative.py"
    },
    {
      "src": "/demo/(.*)",
      "dest": "/demo/$1"
    },
    {
      "src": "/styles.css",
      "dest": "/demo/styles.css"
    },
    {
      "src": "/data.js",
      "dest": "/demo/data.js"
    },
    {
      "src": "/app.js",
      "dest": "/demo/app.js"
    },
    {
      "src": "/constellation.js",
      "dest": "/demo/constellation.js"
    },
    {
      "src": "/demo",
      "dest": "/demo/index.html"
    },
    {
      "src": "/",
      "dest": "/demo/index.html"
    }
  ]
}
